{
  "name": "mpn-editor-build",
  "private": true,
  "description": "Builds the code editor of the web panel (CodeMirror 6, MIT licence) into one file that the panel embeds. Run: npm install && npm run build",
  "scripts": {
    "build": "esbuild entry.js --bundle --splitting --minify --format=esm --target=es2020 --legal-comments=none --entry-names=editor --chunk-names=chunk-[hash] --outdir=../../internal/web/assets/editor"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-php": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/lang-xml": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/legacy-modes": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/theme-one-dark": "^6",
    "@codemirror/view": "^6"
  },
  "devDependencies": {
    "esbuild": "^0.25"
  }
}
